# 3proxy mini-project configuration
# Copy to .env and fill in real values; .env is gitignored.

# HTTP proxy basic auth (required) — used by curl / Nuclei / WPScan / Guzzle
PROXY_LOGIN=vwproxy
# Use a strong password: `openssl rand -hex 24`
PROXY_PASSWORD=CHANGE_ME

# Authenticated HTTP proxy port (public)
PROXY_PORT=3128

# Unauthenticated HTTP proxy port for Chrome/Puppeteer (they cannot send basic-auth).
# Exposed publicly (see docker-compose.yml) but ACL-locked to the IP below.
PROXY_BROWSER_PORT=3129

# Source IP/subnet allowed to use the unauthenticated browser port (3129).
# Uses 3proxy `allow` syntax — a single IP or CIDR subnet. Defaults to
# loopback-only (safe). When the VulnWatch VPS consumes this proxy, set this to
# that VPS's PUBLIC IP, e.g.:
#   PROXY_BROWSER_ALLOW_IP=203.0.113.10/32
PROXY_BROWSER_ALLOW_IP=127.0.0.1/32